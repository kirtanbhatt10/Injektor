# Reference list of variables. Injektor does not load this file: set them in your shell.
INJEKTOR_ENDPOINT=http://127.0.0.1:8765/v1/chat/completions
INJEKTOR_MODEL=injektor-demo
# Set INJEKTOR_API_KEY only if your explicitly authorized endpoint needs one.
# INJEKTOR_API_KEY=
# Seconds allowed for one whole request: connecting, response headers and response body.
INJEKTOR_TIMEOUT=15
INJEKTOR_RETRIES=1
# Seconds to wait between cases (0 to 60). Raise it for rate-limited targets.
INJEKTOR_DELAY=0
